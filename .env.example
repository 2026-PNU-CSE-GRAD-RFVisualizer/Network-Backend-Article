APP_HOST=0.0.0.0
APP_PORT=8000

MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

DATABASE_DSN=postgresql://jhkang:jhkang@127.0.0.1:5432/jhkang_network

# 실시간 시각화(9월 졸업작품). 논문 실험에서는 false 유지.
ENABLE_REALTIME=false

WINDOW_SIZE_MS=200
WINDOW_FLUSH_INTERVAL_MS=50
NODE_TIMEOUT_SECONDS=5
TIMESTAMP_MAX_SKEW_MS=600000
RSSI_MIN=-100
RSSI_MAX=-10

# --- 논문 실험 ---
EXPERIMENT_DATA_DIR=data
EXPORT_ROOT=experiments
DEFAULT_SESSION_SECONDS=30
EXPECTED_SAMPLES_PER_POINT=30
# 펌웨어가 Filtered RSSI 를 x10 정수로 보내면 10 으로 설정
RSSI_FILTERED_SCALE=1.0
